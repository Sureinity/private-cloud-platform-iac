#!/usr/bin/env bash
# Managed by Ansible — do not edit by hand.
# Certbot post-renewal hook for SeaweedFS
set -euo pipefail

LIVE_DIR="/etc/letsencrypt/live/{{ seaweedfs_endpoint_hostname }}"
TARGET_CERT="{{ seaweedfs_s3_cert_file }}"
TARGET_KEY="{{ seaweedfs_s3_key_file }}"

if [[ -f "${LIVE_DIR}/fullchain.pem" && -f "${LIVE_DIR}/privkey.pem" ]]; then
  cp -L "${LIVE_DIR}/fullchain.pem" "${TARGET_CERT}"
  cp -L "${LIVE_DIR}/privkey.pem" "${TARGET_KEY}"
  chown root:{{ seaweedfs_group }} "${TARGET_CERT}"
  chmod 0644 "${TARGET_CERT}"
  chown {{ seaweedfs_user }}:{{ seaweedfs_group }} "${TARGET_KEY}"
  chmod 0600 "${TARGET_KEY}"

  if systemctl is-active --quiet seaweedfs.service; then
    systemctl restart seaweedfs.service
  fi
fi
